DATABASE_URL=
JWT_SECRET=
# 32-byte AES key encoded as 64 hexadecimal characters or base64. Never commit real values.
LAKEESHOP_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: sender label/address when using server SMTP rather than saved settings.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=GN Alliances
# Optional stable secret for encrypted SMTP credentials (keep private and backed up).
EMAIL_SETTINGS_ENCRYPTION_KEY=
# Used only when explicitly running npm run create-admin; never committed real values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
